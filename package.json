{
  "name": "baton-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for @baton-tools/harness (CLI/plugin) and @baton-tools/workbench (kanban UI). Spec-driven autonomous-development tooling.",
  "license": "MIT",
  "author": "Steven Goff",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish"
  },
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@fission-ai/openspec",
      "better-sqlite3",
      "esbuild"
    ]
  }
}
