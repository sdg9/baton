{
  "name": "@baton-tools/harness",
  "version": "0.2.1",
  "description": "Spec-driven autonomous-development harness with frozen holdout contracts, tier-aware adversarial review, and an OpenSpec workflow. Project-agnostic core; per-repo config.",
  "license": "MIT",
  "author": "Steven Goff",
  "homepage": "https://github.com/sdg9/baton/tree/main/packages/harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdg9/baton.git",
    "directory": "packages/harness"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "baton-harness": "bin/baton-harness.js"
  },
  "files": [
    "src",
    "dist",
    "bin",
    "plugin",
    "templates",
    "schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-schema.mjs",
    "build:schema": "node scripts/build-schema.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@fission-ai/openspec": "^1.3.1",
    "marked": "^14.1.4",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-json-schema-generator": "^2.3.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.5"
  },
  "keywords": [
    "openspec",
    "harness",
    "claude-code",
    "spec-driven",
    "autonomous-development",
    "agentic",
    "holdout"
  ]
}
